# ==============================================================================
# The World Family Karaoke — Environment Configuration Example
# Copy to `.env` for local development and fill in only the services you use.
# Never commit real secrets to version control.
# ==============================================================================

# --- DJ Authentication (Required in production; local dev defaults if unset) ---
# Password required to sign into /dj and unlock /stage
DJ_PASSWORD="change-me-local-dj-password"
# Secret used to HMAC-SHA256 sign the HTTP-only `mh-dj` session cookie (min 32 chars)
DJ_SESSION_SECRET="change-me-to-a-long-random-secret-at-least-32-chars"

# --- Database (Optional: embeds local PostgreSQL via PGlite if unset) ---
# Set DATABASE_URL to connect to an external PostgreSQL database (or Supabase DB URI).
# When unset, the server persists data locally in ./.data/pglite via PGlite.
# DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/karaoke"
# PGLITE_DATA_DIR="./.data/pglite"

# --- Supabase (Optional: for external Supabase backend / Auth / Realtime) ---
# Leave unset to run completely locally without touching production Supabase.
# SUPABASE_URL="https://your-dev-project.supabase.co"
# SUPABASE_PUBLISHABLE_KEY="your-dev-anon-or-publishable-key"
# SUPABASE_SERVICE_ROLE_KEY="your-dev-service-role-key"
# VITE_SUPABASE_URL="https://your-dev-project.supabase.co"
# VITE_SUPABASE_PUBLISHABLE_KEY="your-dev-anon-or-publishable-key"

# --- YouTube Data API v3 (Server-side only) ---
# Required for live YouTube karaoke search. If unset, search reports "config" honestly.
YOUTUBE_API_KEY=""

# --- AI Song Suggestions (Server-side only) ---
# Supports GEMINI_API_KEY (recommended, via @google/genai) or OPENAI_API_KEY.
GEMINI_API_KEY="MY_GEMINI_API_KEY"
# OPENAI_API_KEY=""

# --- ElevenLabs Voice Announcements (Server-side only, optional) ---
# If unset, stage opener announcements automatically fall back to browser speechSynthesis.
ELEVENLABS_API_KEY=""
ELEVENLABS_VOICE_ID=""

# --- App Runtime ---
PORT="3000"
APP_URL="http://localhost:3000"
